{
  "manifest_version": 3,
  "name": "Voice Answers for WaniKani: Unofficial Tool",
  "version": "0.4.1",
  "description": "An unofficial tool: answer WaniKani reviews by voice. Speech recognition runs entirely on your device.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wanikani-voice@jsmrcina",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.wanikani.com/*"
  ],
  "background": {
    "scripts": [
      "src/shared/browser-shim.js",
      "src/shared/settings.js",
      "src/shared/homophones.js",
      "src/shared/normalize.js",
      "src/shared/wire.js",
      "src/background/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wanikani.com/*"
      ],
      "js": [
        "src/shared/browser-shim.js",
        "src/shared/settings.js",
        "src/shared/wire.js",
        "src/content/page-reader.js",
        "src/content/answer-io.js",
        "src/content/indicator.js",
        "src/content/audio.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.wanikani.com/*"
      ],
      "js": [
        "src/page/ignore-answer.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Voice Answers for WaniKani: Unofficial Tool",
    "default_icon": "icons/icon.svg",
    "default_popup": "src/options/options.html?popup"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Pause or resume voice answers"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'self'"
  }
}
